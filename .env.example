# Application
APP_NAME=LinkedIn Profile API
APP_VERSION=1.0.0
ENVIRONMENT=development

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Performance
CACHE_TTL_SECONDS=300
CACHE_MAX_ITEMS=100
