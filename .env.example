# Application
APP_NAME=LinkedIn Profile API
APP_VERSION=1.0.0
ENVIRONMENT=development

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Performance
CACHE_TTL_SECONDS=300
CACHE_MAX_ITEMS=100
REQUEST_TIMEOUT_SECONDS=20

# Unique profile lookups per client IP per window.
# 10 unique profile URLs per 60 seconds (1 minute).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Set true to return built-in demo data.
# Leave false for real LinkedIn Voyager lookups.
USE_DEMO_PROVIDER=false

# LinkedIn OAuth 2.0 (OpenID Connect)
# Create an app at https://www.linkedin.com/developers/apps
# and request the "Sign In with LinkedIn using
# OpenID Connect" product.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback
LINKEDIN_SCOPES=openid profile email

# Where the backend sends the browser after sign-in
FRONTEND_URL=http://localhost:5173

# Server-side session lifetime
SESSION_TTL_SECONDS=3600
SESSION_MAX_ITEMS=500

# Token persistence. Path is relative to backend/
# and written with owner-only permissions.
TOKEN_PERSISTENCE_ENABLED=true
TOKEN_STORE_PATH=.secrets/linkedin_token.json

# Require visitor OAuth before URL lookups.
# Leave false for the public challenge API.
REQUIRE_AUTH_FOR_PROFILE=false

# LinkedIn member session for Voyager HTTP calls.
# Copy li_at (and optionally JSESSIONID) from
# DevTools after you log in at linkedin.com.
# The API never drives a browser; it only sends
# these cookies on HTTPS requests to LinkedIn.
# Never commit this value.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Optional authorized provider (URL-based lookups)
PROVIDER_BASE_URL=
PROVIDER_API_KEY=

# Frontend. Leave empty to use the Vite proxy
# so the session cookie stays same-origin.
VITE_API_URL=

# Where the Vite dev proxy forwards /api calls
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
